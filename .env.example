# Copy this file to .env and fill in real values for local development.
# On Vercel, set these under Project Settings → Environment Variables instead
# (DATABASE_URL is set automatically if you add the Neon integration).

# Required — Postgres connection string (Neon). Get one free at neon.tech,
# or add the Neon integration from the Vercel Marketplace to your project.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Required — any long random string, used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional — only needed to send real password-reset emails. Without these,
# the reset code is printed to the server console instead.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
